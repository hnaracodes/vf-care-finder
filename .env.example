# Copy to .env and fill in. Never commit .env.

# Needed by WP3 (LLM teacher labels). Leave empty to skip the teacher and fall back to regex labels.
ANTHROPIC_API_KEY=

# Model used for teacher labeling. A small, fast model is enough for tagging short facts.
VF_LLM_MODEL=claude-haiku-5-5

# Hard cap on total LLM spend across all agents, in US dollars. Agents must stop at this number.
VF_LLM_BUDGET_USD=30

# Optional: point every worktree at one data folder explicitly.
# By default vf.paths finds the main checkout's data/ folder on its own.
# VF_DATA_DIR=/Users/hrudaynara/Projects/CMU Datathon/data
